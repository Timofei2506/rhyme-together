{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "rhyme-together",
  "main": "worker/index.js",
  "compatibility_date": "2026-01-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  "workers_dev": true,

  // Durable Objects: одна комната = один объект, лобби раздаёт коды
  "durable_objects": {
    "bindings": [
      { "name": "ROOMS", "class_name": "RoomDO" },
      { "name": "LOBBY", "class_name": "Lobby" }
    ]
  },
  // Free-план разрешает Durable Objects только на движке sqlite
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["RoomDO", "Lobby"] }
  ],

  "vars": {
    "RHYME_TOGETHER_DEBUG": "1",
    "ALLOWED_ORIGINS": "*"
  }
}
